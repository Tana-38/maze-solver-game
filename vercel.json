{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "{src,web}/**/*.py",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" },
    { "source": "/", "destination": "/web/static/index.html" },
    { "source": "/:dir(css|js)/:file*", "destination": "/web/static/:dir/:file*" }
  ]
}
